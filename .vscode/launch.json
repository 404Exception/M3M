{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "🚀 Debug Server (Backend + Vite)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/server.ts",
      "runtimeArgs": ["--import", "tsx"],
      "cwd": "${workspaceFolder}",
      "restart": true,
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": ["<node_internals>/**"],
      "env": {
        "NODE_ENV": "development"
      }
    },
    {
      "name": "🌐 Debug Frontend (Edge)",
      "type": "msedge",
      "request": "launch",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}",
      "sourceMaps": true
    },
    {
      "name": "🌐 Debug Frontend (Chrome)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}",
      "sourceMaps": true
    },
    {
      "name": "⚡ Debug npm run dev",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "🌱 Debug Database Seed Script",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/backend/src/scripts/seedDatabase.ts",
      "runtimeArgs": ["--import", "tsx"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    }
  ],
  "compounds": [
    {
      "name": "🔥 Full Stack: Server + Edge",
      "configurations": ["🚀 Debug Server (Backend + Vite)", "🌐 Debug Frontend (Edge)"]
    },
    {
      "name": "🔥 Full Stack: Server + Chrome",
      "configurations": ["🚀 Debug Server (Backend + Vite)", "🌐 Debug Frontend (Chrome)"]
    }
  ]
}
